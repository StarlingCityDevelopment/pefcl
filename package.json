{
  "name": "pefcl",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/project-error/pefcl",
  "author": "projecterror <info@projecterror.dev>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:web": "wait-on tcp:127.0.0.1:3005 && cd web && vite dev",
    "dev:server": "NODE_ENV=mocking bun --watch dist/server.js",
    "dev:watch": "bun scripts/build.js --watch",
    "dev": "concurrently -n \"WATCH,SERVER,WEB\" -c \"blue,green,magenta\" --kill-others \"bun dev:watch\" \"bun dev:server\" \"bun dev:web\"",
    "build": "bun scripts/build.js",
    "format": "bun biome format --write",
    "lint": "bun biome check --write",
    "translations:generate": "bun i18next",
    "translations:generate-index": "node ./scripts/generateLocales.js",
    "translations:pull": "localazy download && node ./scripts/generateLocales.js",
    "translations:push": "localazy upload -w $LOCALAZY_WRITE_KEY -r $LOCALAZY_READ_KEY"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@communityox/fx-utils": "^0.0.4",
    "@jgoz/esbuild-plugin-typecheck": "^4.0.3",
    "@localazy/cli": "^1.7.16",
    "@swc/core": "^1.15.26",
    "@tailwindcss/vite": "^4.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.9",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "esbuild-plugin-swc": "^1.0.1",
    "esbuild-plugin-tsc": "^0.5.0",
    "i18next-parser": "^9.4.0",
    "postcss": "^8.5.10",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2",
    "vite": "^5.4.14",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-top-level-await": "^1.6.0",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@communityox/ox_lib": "latest",
    "@nativewrappers/fivem": "latest",
    "@project-error/npwd-types": "^1.3.4",
    "@project-error/pe-utils": "^0.3.0",
    "@solidjs/router": "^0.16.1",
    "body-parser": "^1.19.2",
    "copy-to-clipboard": "^3.3.2",
    "cors": "^2.8.6",
    "dayjs": "^1.10.8",
    "express": "^5.2.1",
    "i18next": "^21.9.1",
    "logform": "^2.3.2",
    "lucide-solid": "^1.16.0",
    "motion-solid": "^0.5.0",
    "mysql2": "^2.3.3",
    "sequelize": "^6.17.0",
    "solid-js": "^1.9.13",
    "winston": "^3.4.0"
  }
}