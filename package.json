{
  "name": "pefcl",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/project-error/pefcl",
  "author": "projecterror <info@projecterror.dev>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:web": "wait-on tcp:127.0.0.1:3005 && cd web && vite dev",
    "dev:server": "NODE_ENV=mocking bun --watch dist/server.js",
    "dev:watch": "bun scripts/build.js --watch",
    "dev": "concurrently -n \"WATCH,SERVER,WEB\" -c \"blue,green,magenta\" --kill-others \"bun dev:watch\" \"bun dev:server\" \"bun dev:web\"",
    "build": "bun scripts/build.js",
    "format": "bun biome format --write",
    "lint": "bun biome check --write",
    "translations:generate": "bun i18next",
    "translations:generate-index": "node ./scripts/generateLocales.js",
    "translations:pull": "localazy download && node ./scripts/generateLocales.js",
    "translations:push": "localazy upload -w $LOCALAZY_WRITE_KEY -r $LOCALAZY_READ_KEY"
  },
  "devDependencies": {
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@communityox/fx-utils": "^0.0.4",
    "@jgoz/esbuild-plugin-typecheck": "^4.0.3",
    "@localazy/cli": "^1.7.16",
    "@swc/core": "^1.15.26",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "axios": "^0.26.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "esbuild-plugin-swc": "^1.0.1",
    "esbuild-plugin-tsc": "^0.5.0",
    "lucide-react": "^1.8.0",
    "postcss": "^8.5.10",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2",
    "vite": "^5.4.14",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@biomejs/biome": "^1.9.4",
    "@communityox/ox_lib": "latest",
    "@emotion/react": "^11.7.0",
    "@emotion/styled": "^11.6.0",
    "@mui/icons-material": "^5.2.0",
    "@mui/lab": "^5.0.0-alpha.45",
    "@mui/material": "^5.2.1",
    "@mui/styles": "^5.2.1",
    "@nativewrappers/fivem": "latest",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@project-error/npwd-types": "^1.3.4",
    "@project-error/pe-utils": "^0.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "body-parser": "^1.19.2",
    "copy-to-clipboard": "^3.3.2",
    "cors": "^2.8.6",
    "dayjs": "^1.10.8",
    "emotion": "^11.0.0",
    "express": "^5.2.1",
    "i18next": "^21.9.1",
    "i18next-parser": "^9.3.0",
    "jotai": "^1.6.0",
    "lodash": "^4.18.1",
    "logform": "^2.3.2",
    "motion": "^12.4.2",
    "mysql2": "^2.3.3",
    "notistack": "^2.0.3",
    "pg": "^8.7.3",
    "pg-hstore": "^2.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-fivem-hooks": "^1.0.4",
    "react-hook-form": "^7.29.0",
    "react-i18next": "^11.16.2",
    "react-router": "^7.1.5",
    "reflect-metadata": "^0.1.13",
